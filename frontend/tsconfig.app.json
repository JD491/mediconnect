{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "ES2021.String", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode (Vite) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strict type-checking, applied to .ts/.tsx files */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    /* Incremental migration: the ~40 existing page components remain valid
       JavaScript (.jsx) and are allowed to coexist with strictly-typed .ts/
       .tsx modules (lib/, components/, types/, hooks/). This is a
       deliberate "strangler fig" strategy, not a shortcut — converting every
       page in one unverifiable pass would trade a working app for an
       unverified 7,000-line diff. New/refactored code goes in as .tsx;
       existing .jsx pages import typed modules (getting real type-checking
       on their Supabase calls) and migrate to .tsx incrementally over time. */
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src"]
}
